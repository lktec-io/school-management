# ---------------------------------------------------------------
# Server
# ---------------------------------------------------------------
NODE_ENV=production
PORT=5000
# Number of reverse proxies in front of the app (1 when behind Nginx on the VPS, 0 locally)
TRUST_PROXY=1
# Public hostname of the portal. CORS_ORIGINS defaults to https://<DOMAIN> when left empty.
DOMAIN=school.clixworks.co.tz
# Comma-separated list of allowed browser origins (only needed for extra origins)
CORS_ORIGINS=

# ---------------------------------------------------------------
# MySQL
# ---------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=school_app
DB_PASSWORD=
DB_NAME=school_management
DB_CONNECTION_LIMIT=10
# East Africa Time (Zanzibar)
DB_TIMEZONE=+03:00

# ---------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN_MINUTES=480
JWT_ISSUER=school-management-api
JWT_AUDIENCE=school-management-portal
BCRYPT_SALT_ROUNDS=12
# Failed attempts before an account is temporarily locked, and lock duration
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Set to true only if non-browser clients need the token in the login response body
AUTH_EXPOSE_TOKEN=false

# ---------------------------------------------------------------
# Session cookie
# ---------------------------------------------------------------
COOKIE_NAME=sms_session
COOKIE_SECURE=true
# strict | lax | none   (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=strict
# Leave empty to scope the cookie to the exact API host
COOKIE_DOMAIN=

# ---------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
# Per client IP across all API calls. Staff on the school network usually share one public IP,
# and each page load makes several calls, so keep this generous.
RATE_LIMIT_MAX=2000
LOGIN_RATE_LIMIT_MAX=10

# ---------------------------------------------------------------
# School identity (printed on report cards and receipts)
# These are defaults: the Headmaster can override them under School Settings.
# ---------------------------------------------------------------
SCHOOL_NAME=
SCHOOL_REGISTRATION_NO=
SCHOOL_ADDRESS=P.O. Box 0000, Zanzibar, Tanzania
SCHOOL_PHONE=
SCHOOL_EMAIL=
SCHOOL_MOTTO=
# Absolute path to a PNG/JPEG crest; a drawn seal is used when empty
SCHOOL_LOGO_PATH=
# Registration numbers are generated as PREFIX/YEAR/SEQUENCE, e.g. ZNZ/2026/001
REG_NUMBER_PREFIX=ZNZ

# ---------------------------------------------------------------
# Storage & backups
# ---------------------------------------------------------------
# Uploaded logo/stamp/signature images (defaults to server/storage)
STORAGE_DIR=
# Where bin/backup-db.sh writes daily dumps and the Headmaster can download them (defaults to server/storage/backups)
BACKUP_DIR=
# Full path if mysqldump is not on PATH
MYSQLDUMP_PATH=mysqldump

# ---------------------------------------------------------------
# Finance document numbering (e.g. RCT-2026-0001, EXP-2026-0001)
# ---------------------------------------------------------------
RECEIPT_PREFIX=RCT
EXPENSE_PREFIX=EXP

# ---------------------------------------------------------------
# Beem Africa SMS — keys from https://login.beem.africa (Profile → Authentication Information)
# SMS is disabled (messages are logged as failed) until all three values are set.
# ---------------------------------------------------------------
BEEM_API_KEY=
BEEM_SECRET_KEY=
# Approved sender name, max 11 characters (e.g. ALNOOR)
BEEM_SENDER_ID=
BEEM_BASE_URL=https://apisms.beem.africa/v1/send
BEEM_BALANCE_URL=https://apisms.beem.africa/public/v1/vendors/balance
BEEM_TIMEOUT_MS=15000
# Send an SMS receipt to the guardian whenever a payment is recorded
SMS_PAYMENT_CONFIRMATION=true
